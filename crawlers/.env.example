PLATFORM=reddit
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=crawler-group
KAFKA_MAX_POLL_INTERVAL_MS=900000
REDIS_URL=redis://localhost:6379/0
BROWSER_HEADLESS=true
NAVIGATION_TIMEOUT_MS=45000
HUMAN_DELAY_MIN=1.2
HUMAN_DELAY_MAX=3.8
MAX_NO_PROGRESS_ATTEMPTS=5
MAX_PAGES_PER_TASK=200
MAX_INITIAL_LOOKBACK_HOURS=2
SINCE_POLICY=reject
MAX_RETRIES=3
INITIAL_BACKOFF=1.0
MAX_BACKOFF=30.0
DEBUG_DIR=output/debug
